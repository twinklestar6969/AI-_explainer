# Supabase Session Pooler connection string.
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection String -> "Session pooler" tab.
#
# Format:
# postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Never commit the real .env file -- only this template.
DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:<port>/postgres

# AWS Configuration
AWS_REGION=us-east-1

# Groq LLM (security explanations for FAIL findings only)
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Set to false to force local rule templates even if GROQ_API_KEY is set
LLM_ENABLED=true
